{
  "manifest_version": 3,
  "name": "Pokémon Cardmarket",
  "version": "1.0.0",
  "description": "Langue préférée, minima par état et historique des prix du JCC Pokémon sur Cardmarket.",
  "permissions": ["storage"],
  "icons": {
    "16": "assets/icons/cardmarket-16.png",
    "48": "assets/icons/cardmarket-48.png",
    "128": "assets/icons/cardmarket-128.png"
  },
  "optional_host_permissions": [
    "https://charts.matrastcg.de/*"
  ],
  "web_accessible_resources": [{
    "resources": [
      "pokemon.css",
      "assets/grading/logos/ace.svg",
      "assets/grading/logos/ags.svg",
      "assets/grading/logos/ars.png",
      "assets/grading/logos/bgs.jpg",
      "assets/grading/logos/ccc.svg",
      "assets/grading/logos/cgc.png",
      "assets/grading/logos/collect-aura.png",
      "assets/grading/logos/gma.png",
      "assets/grading/logos/graad.png",
      "assets/grading/logos/hga.svg",
      "assets/grading/logos/ksa.jpg",
      "assets/grading/logos/mnt.png",
      "assets/grading/logos/pca.png",
      "assets/grading/logos/psa.jpg",
      "assets/grading/logos/pure-grading.svg",
      "assets/grading/logos/sgc.png",
      "assets/grading/logos/tag.png"
    ],
    "matches": [
      "https://www.cardmarket.com/*",
      "https://cardmarket.com/*"
    ]
  }],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://www.cardmarket.com/Pokemon/Products/*",
      "https://www.cardmarket.com/*/Pokemon/Products/*",
      "https://cardmarket.com/Pokemon/Products/*",
      "https://cardmarket.com/*/Pokemon/Products/*"
    ],
    "js": ["core.js", "settings.js", "runtime-guard.js", "pokemon-offers.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Pokémon Cardmarket",
    "default_icon": {
      "16": "assets/icons/cardmarket-16.png",
      "48": "assets/icons/cardmarket-48.png",
      "128": "assets/icons/cardmarket-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
