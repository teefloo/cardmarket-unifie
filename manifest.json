{
  "manifest_version": 3,
  "name": "Pokémon Cardmarket",
  "version": "1.0.1",
  "description": "Langue et minima par état, aperçu et prix mini des listes Wants, historique pour les cartes Pokémon sur Cardmarket.",
  "permissions": ["storage"],
  "icons": {
    "16": "assets/store/chrome-icon-16.png",
    "48": "assets/store/chrome-icon-48.png",
    "128": "assets/store/chrome-icon-128.png"
  },
  "optional_host_permissions": [
    "https://charts.matrastcg.de/*"
  ],
  "web_accessible_resources": [{
    "resources": [
      "pokemon.css"
    ],
    "matches": [
      "https://www.cardmarket.com/Pokemon/Products/*",
      "https://www.cardmarket.com/*/Pokemon/Products/*",
      "https://www.cardmarket.com/Pokemon/Wants",
      "https://www.cardmarket.com/Pokemon/Wants/*",
      "https://www.cardmarket.com/*/Pokemon/Wants",
      "https://www.cardmarket.com/*/Pokemon/Wants/*",
      "https://cardmarket.com/Pokemon/Products/*",
      "https://cardmarket.com/*/Pokemon/Products/*",
      "https://cardmarket.com/Pokemon/Wants",
      "https://cardmarket.com/Pokemon/Wants/*",
      "https://cardmarket.com/*/Pokemon/Wants",
      "https://cardmarket.com/*/Pokemon/Wants/*"
    ]
  }],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://www.cardmarket.com/Pokemon/Products/*",
      "https://www.cardmarket.com/*/Pokemon/Products/*",
      "https://cardmarket.com/Pokemon/Products/*",
      "https://cardmarket.com/*/Pokemon/Products/*"
    ],
    "js": ["core.js", "settings.js", "runtime-guard.js", "pokemon-offers.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": [
      "https://www.cardmarket.com/Pokemon/Wants",
      "https://www.cardmarket.com/Pokemon/Wants/*",
      "https://www.cardmarket.com/*/Pokemon/Wants",
      "https://www.cardmarket.com/*/Pokemon/Wants/*",
      "https://cardmarket.com/Pokemon/Wants",
      "https://cardmarket.com/Pokemon/Wants/*",
      "https://cardmarket.com/*/Pokemon/Wants",
      "https://cardmarket.com/*/Pokemon/Wants/*"
    ],
    "js": ["settings.js", "wants-prices.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Pokémon Cardmarket",
    "default_icon": {
      "16": "assets/store/chrome-icon-16.png",
      "48": "assets/store/chrome-icon-48.png",
      "128": "assets/store/chrome-icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
